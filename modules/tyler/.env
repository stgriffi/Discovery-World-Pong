# Game window width (px)
REACT_APP_GAME_WIDTH = 192  
# Game window height (px)
REACT_APP_GAME_HEIGHT = 160

# Backwards offset of Paddles from center
REACT_APP_PADDLE_OFFSET = 3.5
# size in px from game engine
REACT_APP_PADDLE_WIDTH = 20 
REACT_APP_PADDLE_HEIGHT = 3
# size in px from game engine
REACT_APP_BALL_DIAMETER = 8

# REACT_APP_MQTT_BROKER=localhost
REACT_APP_MQTT_PORT=9001

# Source maps on so browser stack traces point at original files (the drei/@mediapipe
# "Failed to parse source map" warning is harmless; Docker builds do not set CI).
GENERATE_SOURCEMAP=true
